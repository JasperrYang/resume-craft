{
  "compilerOptions": {
    "strict": true,
    "target": "ES2017",
    "module": "ES2015",
    "moduleResolution": "node",
    "lib": ["ES2017"],
    "outDir": "./",
    "rootDir": "./",
    "typeRoots": ["./typings"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
