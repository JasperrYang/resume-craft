/* ResumeCraft 全局样式 */

/* ============ CSS 变量 ============ */
page {
  --color-primary: #1A56DB;
  --color-primary-light: #E8EEFB;
  --color-success: #059669;
  --color-warning: #D97706;
  --color-danger: #DC2626;
  --color-accent: #7C3AED;
  --color-text: #111827;
  --color-text-secondary: #6B7280;
  --color-text-hint: #9CA3AF;
  --color-bg: #F3F4F6;
  --color-white: #FFFFFF;
  --color-border: #E5E7EB;
  --radius: 16rpx;
  --radius-sm: 8rpx;
  --shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg);
  line-height: 1.6;
}

/* ============ 通用类 ============ */
.container {
  padding: 32rpx;
}

.card {
  background: var(--color-white);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* ============ 按钮 ============ */
.btn-primary {
  background: var(--color-primary);
  color: var(--color-white);
  border: none;
  border-radius: var(--radius);
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background: var(--color-white);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius);
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.btn-secondary::after {
  border: none;
}

/* ============ 标签 ============ */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-primary {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.tag-success {
  background: #ECFDF5;
  color: var(--color-success);
}

.tag-warning {
  background: #FFFBEB;
  color: var(--color-warning);
}

/* ============ 分数进度条 ============ */
.score-bar {
  height: 16rpx;
  background: #E5E7EB;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 8rpx 0;
}

.score-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.6s ease;
}

.score-low { background: var(--color-danger); }
.score-mid { background: var(--color-warning); }
.score-high { background: var(--color-success); }

/* ============ 空状态 ============ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.empty-state .empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: var(--color-text-hint);
}
