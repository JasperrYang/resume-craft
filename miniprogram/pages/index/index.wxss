/* pages/index/index.wxss - 首页样式 */

.hero {
  text-align: center;
  padding: 64rpx 0 48rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

.hero-subtitle {
  font-size: 30rpx;
  color: var(--color-text);
  margin-top: 12rpx;
  font-weight: 500;
}

.hero-desc {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-top: 8rpx;
}

/* 核心操作入口 */
.action-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  border: 2rpx dashed var(--color-primary);
  background: var(--color-primary-light);
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 48rpx;
  color: var(--color-primary);
  border: 3rpx solid var(--color-primary);
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.action-text {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.action-hint {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.quick-item {
  flex: 1;
  background: var(--color-white);
  border-radius: var(--radius);
  padding: 24rpx;
  text-align: center;
  margin: 0 8rpx;
  box-shadow: var(--shadow);
}

.quick-item:first-child { margin-left: 0; }
.quick-item:last-child { margin-right: 0; }

.quick-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.quick-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

/* 步骤 */
.steps {
  margin-top: 16rpx;
}

.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.step:last-child {
  margin-bottom: 0;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: var(--color-primary);
  color: var(--color-white);
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.step-desc {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-top: 4rpx;
}

/* 产品亮点 */
.features {
  margin-top: 16rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.feature-item:last-child {
  margin-bottom: 0;
}

.feature-icon {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  color: var(--color-success);
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.feature-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}
