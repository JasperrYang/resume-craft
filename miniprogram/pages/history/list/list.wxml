<!--pages/history/list/list.wxml-->
<view class="container">
  <view class="title" style="margin-bottom:24rpx;">优化历史</view>

  <view class="card history-item" wx:for="{{list}}" wx:key="id" bindtap="onViewTask" data-id="{{item.id}}">
    <view class="history-header">
      <view class="history-position">{{item.jd_summary.position || '未知职位'}}</view>
      <view class="tag {{item.is_paid ? 'tag-success' : 'tag-warning'}}">{{item.is_paid ? '已付费' : '免费'}}</view>
    </view>
    <view class="history-company">{{item.jd_summary.company || '未知公司'}} · {{item.resume_title}}</view>
    <view class="history-score" wx:if="{{item.match_score_after}}">
      匹配度 {{item.match_score_before}}% → {{item.match_score_after}}%
    </view>
    <view class="history-time">{{item.created_at}}</view>
  </view>

  <view class="empty-state" wx:if="{{list.length === 0 && !loading}}">
    <view class="empty-text">暂无优化记录</view>
  </view>
</view>
