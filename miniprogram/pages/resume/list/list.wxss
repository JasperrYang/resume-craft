/* pages/resume/list/list.wxss */
.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.btn-add { font-size: 26rpx; color: var(--color-primary); background: var(--color-primary-light); padding: 12rpx 24rpx; border-radius: var(--radius-sm); line-height: 1.4; }
.btn-add::after { border: none; }
.resume-item { position: relative; }
.resume-item-header { display: flex; justify-content: space-between; align-items: center; }
.resume-item-title { font-size: 30rpx; font-weight: 500; }
.resume-item-info { font-size: 26rpx; color: var(--color-text-secondary); margin-top: 8rpx; }
.resume-item-time { font-size: 22rpx; color: var(--color-text-hint); margin-top: 4rpx; }
