/* pages/task/jd-input/jd-input.wxss */

.jd-textarea {
  width: 100%;
  min-height: 400rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 8rpx;
}

.input-field {
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
}

.selected-resume {
  display: flex;
  align-items: center;
  position: relative;
}

.resume-info {
  flex: 1;
  margin-top: 8rpx;
}

.resume-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.resume-detail {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.change-btn {
  font-size: 24rpx;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
}

.bottom-actions {
  margin-top: 48rpx;
  padding-bottom: 48rpx;
}
