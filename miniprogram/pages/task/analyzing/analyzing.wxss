/* pages/task/analyzing/analyzing.wxss */
.analyzing-page { text-align: center; padding-top: 120rpx; }

.analyzing-animation { margin-bottom: 64rpx; }

.analyzing-circle {
  width: 120rpx; height: 120rpx;
  border: 6rpx solid var(--color-primary-light);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  margin: 0 auto 32rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.analyzing-text { font-size: 32rpx; font-weight: 600; color: var(--color-text); }
.analyzing-step { font-size: 26rpx; color: var(--color-text-secondary); margin-top: 12rpx; }

.steps-progress { padding: 0 80rpx; }

.step-item {
  display: flex; align-items: center; padding: 20rpx 0;
  font-size: 26rpx; color: var(--color-text-hint);
}
.step-item.active { color: var(--color-primary); font-weight: 500; }
.step-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: var(--color-border); margin-right: 20rpx;
}
.step-item.active .step-dot { background: var(--color-primary); }
