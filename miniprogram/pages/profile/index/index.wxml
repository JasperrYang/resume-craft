<!--pages/profile/index/index.wxml-->
<view class="container">
  <view class="card profile-header">
    <image class="avatar" src="{{userInfo.avatar_url || '/assets/icons/default-avatar.png'}}" mode="aspectFill" />
    <view class="profile-info">
      <view class="profile-name">{{userInfo.nickname || '未设置昵称'}}</view>
      <view class="profile-id">ID: {{userInfo.id}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">我的权益</view>
    <view class="quota-row">
      <view class="quota-item">
        <view class="quota-value">{{quota.paid_remaining}}</view>
        <view class="quota-label">付费次数</view>
      </view>
      <view class="quota-item">
        <view class="quota-value">{{quota.free_daily_used < 1 ? 1 : 0}}</view>
        <view class="quota-label">今日免费</view>
      </view>
      <view class="quota-item">
        <view class="quota-value">{{quota.chat_remaining}}</view>
        <view class="quota-label">对话次数</view>
      </view>
    </view>
    <button class="btn-primary" style="margin-top:24rpx;" bindtap="onGoPay">购买次数</button>
  </view>

  <view class="card">
    <view class="menu-item" bindtap="onGoResumes">
      <text>我的简历库</text><text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoHistory">
      <text>优化历史</text><text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onFeedback">
      <text>意见反馈</text><text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text>关于我们</text><text class="menu-arrow">›</text>
    </view>
  </view>
</view>
