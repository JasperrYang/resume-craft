/* pages/profile/index/index.wxss */
.profile-header { display: flex; align-items: center; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; margin-right: 24rpx; background: var(--color-bg); }
.profile-name { font-size: 32rpx; font-weight: 600; }
.profile-id { font-size: 22rpx; color: var(--color-text-hint); margin-top: 4rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.quota-row { display: flex; justify-content: space-around; text-align: center; }
.quota-value { font-size: 40rpx; font-weight: 700; color: var(--color-primary); }
.quota-label { font-size: 22rpx; color: var(--color-text-secondary); margin-top: 4rpx; }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-border); font-size: 28rpx; }
.menu-item:last-child { border-bottom: none; }
.menu-arrow { color: var(--color-text-hint); font-size: 32rpx; }
