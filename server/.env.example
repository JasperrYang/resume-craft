# ResumeCraft 后端环境变量配置
# 复制此文件为 .env 并填写实际值

# ============ 应用配置 ============
APP_NAME=ResumeCraft
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_PREFIX=/api/v1

# ============ MongoDB ============
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=resume_craft

# ============ 微信小程序 ============
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# ============ 微信支付 ============
WECHAT_PAY_MCH_ID=your-mch-id
WECHAT_PAY_API_KEY_V3=your-api-key-v3
WECHAT_PAY_SERIAL_NO=your-serial-no
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/v1/pay/notify

# ============ 腾讯云 COS ============
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET=resume-craft-1234567890

# ============ 腾讯云 OCR ============
OCR_SECRET_ID=your-ocr-secret-id
OCR_SECRET_KEY=your-ocr-secret-key

# ============ 腾讯云智能体平台 ============
AI_PLATFORM_APP_ID=your-ai-app-id
AI_PLATFORM_API_KEY=your-ai-api-key
AI_PLATFORM_BASE_URL=https://api.example.com

# ============ JWT ============
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=2
